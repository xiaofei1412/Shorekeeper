  "items": [
    {"id": "T01", "category": "daily_address_question", "text": "漂泊者，窗边的光正好。要把椅子搬近一点吗？"},
    {"id": "T02", "category": "short_reply", "text": "嗯，我在。"},
    {"id": "T03", "category": "daily_pause", "text": "茶还有些烫，先放一会儿。"},
    {"id": "T04", "category": "question_short_sentences", "text": "你想先听哪一段？慢慢选，我等你。"},
    {"id": "T05", "category": "proper_names", "text": "黑海岸、索诺拉、泰缇斯，这三个名字，请听清楚。"},
    {"id": "T06", "category": "numbers_english", "text": "这根 USB Type-C 线长 1.5 米，编号是 A07。"},
    {"id": "T07", "category": "long_explanation", "text": "如果要把书架上的书重新摆好，可以先留出一层空位，再按常用程度挪动。最常翻的几本放在手边，等全部摆好以后，再看看标签是否清楚。"},
    {"id": "T08", "category": "pauses_sentence_ending", "text": "雨停了。我们再等两分钟，等台阶上的水流下去，再出门，好吗？"}
  ]
}
