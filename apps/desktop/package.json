{
  "name": "shorekeeper-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "productName": "守岸人语音工作台",
  "main": "dist/electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.electron.json && vite build --outDir dist/ui",
    "test": "tsc -p tsconfig.electron.json && node --test tests/*.test.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "electron": "45.4.1",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
