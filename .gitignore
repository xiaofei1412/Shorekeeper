# Private data, assets, credentials, runtimes and model outputs stay local.
local/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.token
.netrc
.git-credentials
credentials*.json
secrets*.json
.ssh/
secrets/
credentials/

# Isolated environments, caches and generated files.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
node_modules/
*.egg-info/
build/
dist/
**/bin/
**/obj/

# Defense in depth for assets accidentally placed outside local/.
